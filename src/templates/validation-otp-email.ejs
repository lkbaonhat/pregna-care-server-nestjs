<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Verification</title>
    <style>
      body,
      html {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        line-height: 1.6;
      }
      .container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        background: linear-gradient(90deg, #ee7a7a 0%, #acbcf7 100%);
      }
      .content {
        background-color: #ffffff;
        padding: 30px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      }
      h1 {
        color: #333333;
        margin-top: 0;
      }
      .otp-code {
        font-size: 24px;
        font-weight: bold;
        letter-spacing: 5px;
        text-align: center;
        padding: 15px;
        margin: 20px 0;
        background-color: #f2f2f2;
        border-radius: 4px;
      }
      @media only screen and (max-width: 600px) {
        .container {
          width: 100% !important;
        }
        .content {
          padding: 20px !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="content">
        <h1>Verify Your Email</h1>
        <p>Hello <%= locals.name %>,</p>
        <p>
          Thank you for signing up! Please use the following verification code
          to confirm your email address:
        </p>
        <div class="otp-code"><%= locals.otpCode %></div>
        <p>
          This code will expire in 10 minutes. If you didn't create an account
          with us, please ignore this email.
        </p>
        <p>Best regards,<br />The SWD Team</p>
      </div>
    </div>
  </body>
</html>
